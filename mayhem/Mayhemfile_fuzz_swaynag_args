project: savantenvs/swayfx
target: fuzz_swaynag_args
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_swaynag_args/testsuite
cmds:
  - cmd: /mayhem/fuzz_swaynag_args
    libfuzzer: true
    dictionary: /mayhem/mayhem/fuzz_swaynag_args/fuzz_swaynag_args.dict
    timeout: 60
    env:
      MFUZZ_COMPAT_LEVEL: '2'
